# Copy to .env.local for local development, or edit .env.production for builds.
# Both values are public by design: the database is protected by row-level
# security and server-side functions, not by hiding these values.
# Never put a service_role key or database password in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
